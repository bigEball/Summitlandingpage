# Copy to `.env` for local development. Netlify reads the production value
# from netlify.toml's [build.environment] block, not from this file.

# Where "Open the live demo" goes. This site does not contain the application,
# so the demo buttons have to point off this origin. Left unset, they fall back
# to a relative /login, which does not exist here.
VITE_APP_URL=https://app.summitaisoftware.com/login
