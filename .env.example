# Copy to `.env` for local development. Netlify reads the production values
# from netlify.toml's [build.environment] block, not from this file.

# Where "Open the live demo" goes. This site does not contain the application.
# Leave empty in development if you are running the app on this machine and
# want the link to stay relative; otherwise point it at the app's address.
VITE_APP_URL=http://localhost:5180/login

# Origin of the API that takes contact-form submissions. Leave EMPTY in
# development — empty means same-origin, and vite.config.ts proxies /api to
# localhost:3001, where the `dentalai` Express server runs.
VITE_API_BASE=
